#!name = Skip Proxy And Real-IP Lists
#!desc = 跳过部分应用的代理检测
#!author = DAVID.G
#!system = iOS,iPadOS,tvOS,macOS
#!system_version = 
#!loon_version = 3.3.2(877)
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Apple.png
#!homepage = https://github.com/Tartarus2014/Loon-Script/blob/master/Plugin/skip-proxy.md

[General]
skip-proxy = cmbchina.com,citicbank.com,spdb.com.cn,www.baidu.com,yunbusiness.ccb.com,wap.cmpassport.com,log.cmpassport.com,gate.lagou.com,www.abchina.com.cn,www.shanbay.com,login-service.mobile-bank.psbc.com,mobile-bank.psbc.com,id6.me
real-ip = wap.cmpassport.com,log.cmpassport.com,easy-login.10099.com.cn,*-update.xoyocdn.com,id6.me,open.e.189.cn

[Rule]
DOMAIN,msmp.abchina.com.cn,REJECT

[MitM]
# 不可MitM也不应该被打断连接的域名
hostname = -testflight.apple.com
